generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          String         @default("MEMBER")
  createdAt    DateTime       @default(now())
  updates       Update[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  boards    Board[]
}

model Board {
  id          String       @id @default(cuid())
  // Deleting a project keeps its boards (they show under "Other boards").
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String
  description String       @default("")
  statuses    Json
  columns     Json         @default("[]")
  createdAt   DateTime     @default(now())
  groups      Group[]
  items       Item[]

  @@index([projectId])
}

model Group {
  id       String @id @default(cuid())
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  color    String
  position Int    @default(0)
  items    Item[]

  @@index([boardId])
}

model Item {
  id          String     @id @default(cuid())
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  status      String     @default("NOT_STARTED")
  priority    Priority   @default(MEDIUM)
  assigneeIds String[]   @default([])
  createdById String? 
  due         String? 
  description String     @default("")
  values      Json       @default("{}")
  dependsOn   String[]   @default([])
  position    Float      @default(0)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  subtasks    Subtask[]
  updates     Update[]
  files       File[]
  activity    Activity[]

  @@index([boardId, deletedAt])
  @@index([groupId])
}

model Subtask {
  id         String  @id @default(cuid())
  itemId     String
  item       Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title      String
  done       Boolean @default(false)
  assigneeId String?
  position   Int     @default(0)

  @@index([itemId])
}

model Update {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([itemId])
}

model File {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  url       String?
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Activity {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([itemId])
}
